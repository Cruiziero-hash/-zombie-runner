<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Zombie Escape 3D</title>

<style>
* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #050707;
  font-family: Arial, sans-serif;
}

#game {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

canvas {
  display: block;
}

#hud {
  position: absolute;
  top: 18px;
  left: 18px;
  right: 18px;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  pointer-events: none;
}

.hudBox {
  background: rgba(8, 12, 11, .72);
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 14px;
  padding: 9px 15px;
  color: white;
  min-width: 100px;
  text-align: center;
  backdrop-filter: blur(8px);
}

.hudLabel {
  display: block;
  color: #aeb8b3;
  font-size: 10px;
  letter-spacing: 1px;
}

.hudValue {
  font-size: 21px;
  font-weight: 900;
}

#health {
  color: #e44b3b;
}

#menu {
  position: absolute;
  inset: 0;
  z-index: 20;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(0,0,0,.62);
}

.panel {
  width: min(440px, 90%);
  text-align: center;
  padding: 34px 28px;
  color: white;
  border-radius: 22px;
  background: rgba(12,18,17,.92);
  border: 1px solid rgba(255,255,255,.16);
  box-shadow: 0 25px 80px rgba(0,0,0,.55);
}

.panel h1 {
  margin: 0 0 8px;
  font-size: 42px;
  letter-spacing: 2px;
}

.panel p {
  color: #b6c0bc;
  line-height: 1.5;
}

button {
  border: 0;
  cursor: pointer;
  font-weight: 900;
}

#startButton {
  margin-top: 12px;
  padding: 15px 28px;
  border-radius: 12px;
  background: #d2a52f;
  color: #151515;
  font-size: 17px;
}

#controls {
  position: absolute;
  bottom: 22px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
  display: grid;
  grid-template-columns: repeat(3, 58px);
  gap: 8px;
}

.control {
  width: 58px;
  height: 48px;
  border-radius: 12px;
  background: rgba(5,8,8,.65);
  color: white;
  border: 1px solid rgba(255,255,255,.18);
  font-size: 20px;
}

.control.jump {
  grid-column: 2;
}

.control.left {
  grid-column: 1;
  grid-row: 2;
}

.control.down {
  grid-column: 2;
  grid-row: 2;
}

.control.right {
  grid-column: 3;
  grid-row: 2;
}

.hidden {
  display: none !important;
}

#damage {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 12;
  background: rgba(180,0,0,.28);
  opacity: 0;
  transition: opacity .15s;
}
</style>
</head>

<body>

<div id="game">

  <div id="hud">

    <div class="hudBox">
      <span class="hudLabel">DISTANCE</span>
      <span id="distance" class="hudValue">0 m</span>
    </div>

    <div class="hudBox">
      <span class="hudLabel">COINS</span>
      <span id="coins" class="hudValue">0</span>
    </div>

    <div class="hudBox">
      <span class="hudLabel">HEALTH</span>
      <span id="health" class="hudValue">❤❤❤</span>
    </div>

  </div>

  <div id="damage"></div>

  <div id="menu">
    <div class="panel">

      <h1 id="menuTitle">ZOMBIE ESCAPE</h1>

      <p id="menuText">
        The city has fallen.<br>
        Run, dodge the infected and survive as long as possible.
      </p>

      <button id="startButton">
        START RUN
      </button>

    </div>
  </div>

  <div id="controls">
    <button class="control jump" data-action="jump">↑</button>
    <button class="control left" data-action="left">←</button>
    <button class="control down" data-action="slide">↓</button>
    <button class="control right" data-action="right">→</button>
  </div>

</div>


<script type="module">

import * as THREE from
"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js";


/* ============================================================
   GAME STATE
============================================================ */

let scene;
let camera;
let renderer;

let player;
let zombies = [];
let obstacles = [];
let coins = [];
let scenery = [];

let running = false;

let lane = 0;

let distance = 0;
let coinCount = 0;
let health = 3;

let speed = 18;

let jumping = false;
let sliding = false;

let jumpVelocity = 0;

let lastTime = performance.now();

let spawnTimer = 0;
let zombieTimer = 0;


/* ============================================================
   UI
============================================================ */

const distanceUI =
document.getElementById("distance");

const coinsUI =
document.getElementById("coins");

const healthUI =
document.getElementById("health");

const menu =
document.getElementById("menu");

const menuTitle =
document.getElementById("menuTitle");

const menuText =
document.getElementById("menuText");

const startButton =
document.getElementById("startButton");

const damage =
document.getElementById("damage");


/* ============================================================
   SCENE
============================================================ */

scene = new THREE.Scene();

scene.background =
new THREE.Color(0x182527);

scene.fog =
new THREE.Fog(0x182527, 35, 180);


/* ============================================================
   CAMERA
============================================================ */

camera = new THREE.PerspectiveCamera(
  65,
  window.innerWidth / window.innerHeight,
  0.1,
  500
);

camera.position.set(
  0,
  5.2,
  10
);


/* ============================================================
   RENDERER
============================================================ */

renderer =
new THREE.WebGLRenderer({
  antialias: true
});

renderer.setPixelRatio(
  Math.min(window.devicePixelRatio, 2)
);

renderer.setSize(
  window.innerWidth,
  window.innerHeight
);

renderer.shadowMap.enabled = true;

renderer.shadowMap.type =
THREE.PCFSoftShadowMap;

document
.getElementById("game")
.appendChild(renderer.domElement);


/* ============================================================
   LIGHTING
============================================================ */

const ambient =
new THREE.HemisphereLight(
  0x9ab7c0,
  0x101313,
  2
);

scene.add(ambient);


const sun =
new THREE.DirectionalLight(
  0xffd29a,
  4
);

sun.position.set(
  -25,
  35,
  15
);

sun.castShadow = true;

sun.shadow.mapSize.width = 2048;
sun.shadow.mapSize.height = 2048;

scene.add(sun);


/* ============================================================
   MATERIALS
============================================================ */

const roadMaterial =
new THREE.MeshStandardMaterial({
  color: 0x343735,
  roughness: .9
});

const stoneMaterial =
new THREE.MeshStandardMaterial({
  color: 0x62655e,
  roughness: 1
});

const darkMaterial =
new THREE.MeshStandardMaterial({
  color: 0x252b29,
  roughness: 1
});

const skinMaterial =
new THREE.MeshStandardMaterial({
  color: 0xb87e59
});

const shirtMaterial =
new THREE.MeshStandardMaterial({
  color: 0x35443f
});

const pantsMaterial =
new THREE.MeshStandardMaterial({
  color: 0x202728
});

const zombieSkin =
new THREE.MeshStandardMaterial({
  color: 0x637667
});

const goldMaterial =
new THREE.MeshStandardMaterial({
  color: 0xd6a92f,
  metalness: .8,
  roughness: .25
});


/* ============================================================
   GROUND
============================================================ */

const road =
new THREE.Mesh(
  new THREE.BoxGeometry(
    14,
    .3,
    260
  ),
  roadMaterial
);

road.position.set(
  0,
  -.15,
  -105
);

road.receiveShadow = true;

scene.add(road);


/* ============================================================
   ROAD EDGES
============================================================ */

function createRoadEdge(x) {

  const edge =
  new THREE.Mesh(
    new THREE.BoxGeometry(
      2,
      .8,
      260
    ),
    stoneMaterial
  );

  edge.position.set(
    x,
    .1,
    -105
  );

  edge.castShadow = true;
  edge.receiveShadow = true;

  scene.add(edge);

}

createRoadEdge(-8);
createRoadEdge(8);


/* ============================================================
   LANE MARKERS
============================================================ */

for(let i=0;i<80;i++){

  for(const x of [-2.3,2.3]){

    const marker =
    new THREE.Mesh(
      new THREE.BoxGeometry(
        .12,
        .02,
        2.8
      ),
      new THREE.MeshStandardMaterial({
        color: 0xc2bd9e
      })
    );

    marker.position.set(
      x,
      .02,
      -i * 7
    );

    scene.add(marker);

    scenery.push(marker);
  }

}


/* ============================================================
   PLAYER CHARACTER
============================================================ */

function createCharacter(
  zombie = false
){

  const character =
  new THREE.Group();


  /*
    BODY
  */

  const body =
  new THREE.Mesh(
    new THREE.BoxGeometry(
      .75,
      1.25,
      .48
    ),
    zombie
      ? new THREE.MeshStandardMaterial({
          color: 0x415047
        })
      : shirtMaterial
  );

  body.position.y = 1.65;

  body.castShadow = true;

  character.add(body);


  /*
    HEAD
  */

  const head =
  new THREE.Mesh(
    new THREE.SphereGeometry(
      .38,
      16,
      16
    ),
    zombie
      ? zombieSkin
      : skinMaterial
  );

  head.position.y = 2.55;

  head.castShadow = true;

  character.add(head);


  /*
    HAIR
  */

  if(!zombie){

    const hair =
    new THREE.Mesh(
      new THREE.SphereGeometry(
        .4,
        16,
        8,
        0,
        Math.PI * 2,
        0,
        Math.PI / 2
      ),
      new THREE.MeshStandardMaterial({
        color: 0x241a15
      })
    );

    hair.position.y = 2.67;

    character.add(hair);

  }


  /*
    LEGS
  */

  const legGeo =
  new THREE.BoxGeometry(
    .27,
    1.05,
    .3
  );

  const leftLeg =
  new THREE.Mesh(
    legGeo,
    pantsMaterial
  );

  const rightLeg =
  new THREE.Mesh(
    legGeo,
    pantsMaterial
  );

  leftLeg.position.set(
    -.22,
    .65,
    0
  );

  rightLeg.position.set(
    .22,
    .65,
    0
  );

  leftLeg.castShadow = true;
  rightLeg.castShadow = true;

  character.add(
    leftLeg,
    rightLeg
  );


  /*
    ARMS
  */

  const armGeo =
  new THREE.BoxGeometry(
    .23,
    1,
    .25
  );

  const leftArm =
  new THREE.Mesh(
    armGeo,
    zombie
      ? zombieSkin
      : shirtMaterial
  );

  const rightArm =
  new THREE.Mesh(
    armGeo,
    zombie
      ? zombieSkin
      : shirtMaterial
  );

  leftArm.position.set(
    -.55,
    1.65,
    0
  );

  rightArm.position.set(
    .55,
    1.65,
    0
  );

  leftArm.rotation.z = -.15;
  rightArm.rotation.z = .15;

  leftArm.castShadow = true;
  rightArm.castShadow = true;

  character.add(
    leftArm,
    rightArm
  );


  /*
    ZOMBIE EYES
  */

  if(zombie){

    const eyeMaterial =
    new THREE.MeshBasicMaterial({
      color: 0xff3228
    });

    for(const x of [-.13,.13]){

      const eye =
      new THREE.Mesh(
        new THREE.SphereGeometry(
          .055,
          8,
          8
        ),
        eyeMaterial
      );

      eye.position.set(
        x,
        2.58,
        -.34
      );

      character.add(eye);
    }

  }


  character.userData.leftLeg =
  leftLeg;

  character.userData.rightLeg =
  rightLeg;

  character.userData.leftArm =
  leftArm;

  character.userData.rightArm =
  rightArm;

  return character;
}


/* ============================================================
   PLAYER
============================================================ */

player =
createCharacter(false);

player.position.set(
  0,
  0,
  3
);

scene.add(player);


/* ============================================================
   ZOMBIE
============================================================ */

function createZombie(){

  const zombie =
  createCharacter(true);

  zombie.scale.set(
    1.05,
    1.05,
    1.05
  );

  zombie.position.set(
    THREE.MathUtils.randInt(-1,1) * 2.4,
    0,
    16 + Math.random() * 18
  );

  zombie.rotation.y =
  Math.PI;

  scene.add(zombie);

  zombies.push(zombie);

}


/* ============================================================
   OBSTACLES
============================================================ */

function createObstacle(){

  const type =
  Math.random() < .5
  ? "car"
  : "barrier";

  let mesh;

  if(type === "car"){

    mesh =
    new THREE.Mesh(
      new THREE.BoxGeometry(
        2.2,
        1,
        3.8
      ),
      new THREE.MeshStandardMaterial({
        color: 0x4a3731,
        roughness: .8
      })
    );

  } else {

    mesh =
    new THREE.Mesh(
      new THREE.BoxGeometry(
        2.8,
        .9,
        .7
      ),
      new THREE.MeshStandardMaterial({
        color: 0xb43d32
      })
    );

  }

  mesh.position.set(
    THREE.MathUtils.randInt(-1,1) * 2.4,
    type === "car" ? .55 : .45,
    -70
  );

  mesh.castShadow = true;

  mesh.userData.type =
  type;

  scene.add(mesh);

  obstacles.push(mesh);

}


/* ============================================================
   COINS
============================================================ */

function createCoin(){

  const coin =
  new THREE.Mesh(
    new THREE.TorusGeometry(
      .27,
      .09,
      12,
      24
    ),
    goldMaterial
  );

  coin.position.set(
    THREE.MathUtils.randInt(-1,1) * 2.4,
    1.5,
    -75
  );

  coin.rotation.x =
  Math.PI / 2;

  coin.castShadow = true;

  scene.add(coin);

  coins.push(coin);

}


/* ============================================================
   RUINS / BUILDINGS
============================================================ */

function createScenery(){

  const side =
  Math.random() < .5
  ? -1
  : 1;

  const building =
  new THREE.Mesh(
    new THREE.BoxGeometry(
      3 + Math.random() * 3,
      4 + Math.random() * 8,
      3 + Math.random() * 4
    ),
    darkMaterial
  );

  building.position.set(
    side * (11 + Math.random() * 6),
    building.geometry.parameters.height / 2,
    -80
  );

  building.rotation.y =
  (Math.random()-.5)*.2;

  building.castShadow = true;

  scene.add(building);

  scenery.push(building);

}


/* ============================================================
   PLAYER ACTIONS
============================================================ */

function moveLeft(){

  if(!running)return;

  lane =
  Math.max(
    -1,
    lane - 1
  );

}

function moveRight(){

  if(!running)return;

  lane =
  Math.min(
    1,
    lane + 1
  );

}

function jump(){

  if(
    !running ||
    jumping ||
    sliding
  ) return;

  jumping = true;

  jumpVelocity = 9;

}

function slide(){

  if(
    !running ||
    jumping ||
    sliding
  ) return;

  sliding = true;

  player.scale.y = .55;

  setTimeout(() => {

    sliding = false;

    player.scale.y = 1;

  },650);

}


/* ============================================================
   INPUT
============================================================ */

window.addEventListener(
  "keydown",
  e => {

    if(e.key === "ArrowLeft")
      moveLeft();

    if(e.key === "ArrowRight")
      moveRight();

    if(
      e.key === "ArrowUp" ||
      e.key === " "
    )
      jump();

    if(e.key === "ArrowDown")
      slide();

  }
);


document
.querySelectorAll("[data-action]")
.forEach(button => {

  button.addEventListener(
    "click",
    () => {

      const action =
      button.dataset.action;

      if(action === "left")
        moveLeft();

      if(action === "right")
        moveRight();

      if(action === "jump")
        jump();

      if(action === "slide")
        slide();

    }
  );

});


/* ============================================================
   COLLISION
============================================================ */

function distanceBetween(a,b){

  return a.position.distanceTo(
    b.position
  );

}


function hitObstacle(obstacle){

  const d =
  distanceBetween(
    player,
    obstacle
  );

  if(d < 2.0){

    if(
      jumping &&
      obstacle.userData.type === "barrier"
    )
      return false;

    if(
      sliding &&
      obstacle.userData.type === "car"
    )
      return false;

    return true;

  }

  return false;

}


/* ============================================================
   DAMAGE
============================================================ */

function takeDamage(){

  health--;

  healthUI.textContent =
  "❤".repeat(
    Math.max(0,health)
  ) +
  "♡".repeat(
    3-health
  );

  damage.style.opacity =
  "1";

  setTimeout(() => {

    damage.style.opacity =
    "0";

  },120);

  if(health <= 0)
    gameOver();

}


/* ============================================================
   GAME START
============================================================ */

function startGame(){

  running = true;

  distance = 0;
  coinCount = 0;
  health = 3;

  speed = 18;

  lane = 0;

  jumping = false;
  sliding = false;

  player.position.set(
    0,
    0,
    3
  );

  player.scale.set(
    1,1,1
  );

  zombies.forEach(
    z => scene.remove(z)
  );

  obstacles.forEach(
    o => scene.remove(o)
  );

  coins.forEach(
    c => scene.remove(c)
  );

  zombies = [];
  obstacles = [];
  coins = [];

  distanceUI.textContent =
  "0 m";

  coinsUI.textContent =
  "0";

  healthUI.textContent =
  "❤❤❤";

  menu.classList.add(
    "hidden"
  );

  for(let i=0;i<4;i++)
    createZombie();

  lastTime =
  performance.now();

}


/* ============================================================
   GAME OVER
============================================================ */

function gameOver(){

  running = false;

  menuTitle.textContent =
  "YOU WERE OVERRUN";

  menuText.innerHTML =
  `You survived <b>${Math.floor(distance)}m</b><br>
   Coins collected: <b>${coinCount}</b>`;

  startButton.textContent =
  "RUN AGAIN";

  menu.classList.remove(
    "hidden"
  );

}


/* ============================================================
   ANIMATION
============================================================ */

function animateCharacter(
  character,
  time
){

  const swing =
  Math.sin(time * .012) * .65;

  character.userData.leftLeg.rotation.x =
  swing;

  character.userData.rightLeg.rotation.x =
  -swing;

  character.userData.leftArm.rotation.x =
  -swing;

  character.userData.rightArm.rotation.x =
  swing;

}


/* ============================================================
   MAIN LOOP
============================================================ */

function gameLoop(){

  requestAnimationFrame(
    gameLoop
  );

  const now =
  performance.now();

  const delta =
  Math.min(
    (now-lastTime)/1000,
    .05
  );

  lastTime = now;


  /*
    WORLD
  */

  if(running){

    distance +=
    speed * delta * .15;

    speed +=
    delta * .18;

    distanceUI.textContent =
    Math.floor(distance) +
    " m";


    /*
      PLAYER LANE
    */

    const targetX =
    lane * 2.4;

    player.position.x +=
    (targetX -
     player.position.x) *
    Math.min(
      1,
      delta * 12
    );


    /*
      JUMP PHYSICS
    */

    if(jumping){

      player.position.y +=
      jumpVelocity * delta;

      jumpVelocity -=
      22 * delta;

      if(
        player.position.y <= 0
      ){

        player.position.y =
        0;

        jumping = false;

      }

    }


    /*
      MOVE WORLD
    */

    for(
      const marker of scenery
    ){

      marker.position.z +=
      speed * delta;

      if(
        marker.position.z > 20
      ){

        marker.position.z =
        -180;

      }

    }


    /*
      OBSTACLES
    */

    for(
      let i=obstacles.length-1;
      i>=0;
      i--
    ){

      const obstacle =
      obstacles[i];

      obstacle.position.z +=
      speed * delta;

      if(
        hitObstacle(obstacle)
      ){

        takeDamage();

        scene.remove(
          obstacle
        );

        obstacles.splice(
          i,
          1
        );

        continue;

      }

      if(
        obstacle.position.z > 20
      ){

        scene.remove(
          obstacle
        );

        obstacles.splice(
          i,
          1
        );

      }

    }


    /*
      COINS
    */

    for(
      let i=coins.length-1;
      i>=0;
      i--
    ){

      const coin =
      coins[i];

      coin.position.z +=
      speed * delta;

      coin.rotation.z +=
      delta * 6;

      if(
        distanceBetween(
          player,
          coin
        ) < 1.5
      ){

        coinCount++;

        coinsUI.textContent =
        coinCount;

        scene.remove(
          coin
        );

        coins.splice(
          i,
          1
        );

        continue;

      }

      if(
        coin.position.z > 20
      ){

        scene.remove(
          coin
        );

        coins.splice(
          i,
          1
        );

      }

    }


    /*
      ZOMBIES
    */

    for(
      const zombie of zombies
    ){

      zombie.position.z +=
      speed * delta * .75;

      animateCharacter(
        zombie,
        now
      );

      if(
        zombie.position.z > 9
      ){

        zombie.position.z =
        16 +
        Math.random()*10;

        zombie.position.x =
        THREE.MathUtils.randInt(-1,1)*2.4;

        takeDamage();

      }

    }


    /*
      SPAWNING
    */

    spawnTimer += delta;

    zombieTimer += delta;


    if(
      spawnTimer >
      Math.max(
        .65,
        1.7 - speed*.025
      )
    ){

      createObstacle();

      if(
        Math.random() < .7
      )
        createCoin();

      spawnTimer = 0;

    }


    if(
      zombieTimer > 3
    ){

      createZombie();

      zombieTimer = 0;

    }


    /*
      CAMERA
    */

    camera.position.x +=
    (player.position.x*.25 -
     camera.position.x) *
    delta*4;

    camera.lookAt(
      player.position.x,
      1.7,
      -18
    );


    /*
      PLAYER ANIMATION
    */


    animateCharacter(
      player,
      now
    );

  }


  renderer.render(
    scene,
    camera
  );

}


/* ============================================================
   START BUTTON
============================================================ */

startButton.addEventListener(
  "click",
  startGame
);


/* ============================================================
   WINDOW RESIZE
============================================================ */

window.addEventListener(
  "resize",
  () => {

    camera.aspect =
    window.innerWidth /
    window.innerHeight;

    camera.updateProjectionMatrix();

    renderer.setSize(
      window.innerWidth,
      window.innerHeight
    );

  }
);


/* ============================================================
   INITIAL ENVIRONMENT
============================================================ */

for(let i=0;i<20;i++)
  createScenery();


gameLoop();

</script>

</body>
</html>
